# Application
APP_NAME="DataPOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Yangon
APP_URL=https://yourdomain.com
FORCE_HTTPS=true

APP_LOCALE=my
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Password hashing
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=datapos_commerce
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache / queue / broadcasting
BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync

# File storage
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# External contact placeholders
VIBER_PUBLIC_NUMBER="+959000000000"
TELEGRAM_PUBLIC_USERNAME="your_store_username"

# Store setup record placeholders.
# The current MVP stores these values in the database/admin settings, not env.
STORE_PUBLIC_NAME="DataPOS"
STORE_PUBLIC_SLUG="datapos-mobile"
STORE_PUBLIC_PHONE="+959000000000"

# Optional Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend build
VITE_APP_NAME="${APP_NAME}"

# Safety switches
ALLOW_UAT_SEEDING=false
# Set true only in local/UAT .env files.

# Local production-like HTTP UAT override example:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=http://localhost:8500
# FORCE_HTTPS=false
# SESSION_SECURE_COOKIE=false
# QUEUE_CONNECTION=sync
# ALLOW_UAT_SEEDING=false

# Web Push (VAPID) keys — generate with: php artisan vapid:generate
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shop ⇄ Cloud replication (offline-first counter).
# Leave everything off for a single installation that serves the shop itself:
# the counter then needs no internet at all. See docs/DataPOS_Offline_Sync_MM.md
DATAPOS_SYNC_ENABLED=false
# standalone | terminal  (terminal = this shop pushes its sales to a central one)
DATAPOS_SYNC_ROLE=standalone
# The central installation that serves the storefront, e.g. https://yourdomain.com
DATAPOS_SYNC_CENTRAL_URL=
# The store whose slug the central knows
DATAPOS_SYNC_STORE_SLUG=
# Issued on the central: Stores → Sync → Generate key
DATAPOS_SYNC_API_KEY=
# Name recorded on queued records (defaults to the machine name)
DATAPOS_SYNC_DEVICE_ID=
DATAPOS_SYNC_TIMEOUT=20
DATAPOS_SYNC_VERIFY_TLS=true
DATAPOS_SYNC_BATCH_SIZE=50
DATAPOS_SYNC_MAX_ATTEMPTS=10
